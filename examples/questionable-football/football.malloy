// Questionable Football — the league: teams, games and every play, 2023-2025.
//
// Four grains, one source each:
//
//   teams       one row per franchise, with conference, division and colours
//   games       one row per game, home and away side by side
//   team_games  one row per TEAM per game, so "points for", "record" and
//               "opponent" mean the same thing whichever side a team was on
//   plays       one row per snap, with expected points added (EPA)
//
// Team codes are the ones teams.csv uses everywhere (the Rams are LAR, never
// LA); scripts/build-data.mjs normalises them on the way in, so every join
// below is a plain equality. Fantasy scoring lives in fantasy.malloy and the
// 2026 betting market in market.malloy.

// Position colours follow the Questionable Football site, so a chart drawn by
// the Console reads the same as the HTML pages in public/.
## theme.palette.series = ["#1f2933", "#2fa58d", "#ea8e3c", "#438fc3", "#a75dc1", "#8b97a6"]

#(doc) The 32 NFL franchises, one row per team, keyed by the team code (`PHI`, `KC`, `LAR`). Carries conference, division and the team's primary colour
source: teams is duckdb.table('data/teams.parquet') extend {
  primary_key: team

  dimension:
    #(doc) Location and nickname: "Philadelphia Eagles"
    # label="Team"
    full_name is concat(location, ' ', name)
    #(doc) Conference and division: "NFC East"
    # label="Division"
    conference_division is concat(conference, ' ', division)

  measure:
    #(doc) Teams counted
    # label="Teams"
    team_count is count()

  #(doc) Every team's code, name, division and colours: what the HTML pages paint team chips from, so a colour lives in the data and never in page script
  view: palette is {
    group_by: team, full_name, conference, division, primary_color, secondary_color
    order_by: team
  }
}

#(doc) The roster snapshot the fantasy attribution matched names against: one row per player, keyed by `player_id` (a Pro Football Reference id), with position and team. A player who changed teams appears under the snapshot team only
source: roster is duckdb.table('data/roster.parquet') extend {
  primary_key: player_id
  join_one: teams with team

  measure:
    #(doc) Players counted
    # label="Players"
    player_count is count()
}

#(doc) NFL games 2023-2025, one row per game: regular season (REG) and playoffs (WC, DIV, CON, SB), with final score, overtime, roof and surface. `result` is home score minus away score
source: games is duckdb.table('data/games.parquet') extend {
  primary_key: game_id
  join_one: home is teams on home_team = home.team
  join_one: away is teams on away_team = away.team

  dimension:
    #(doc) "DAL @ PHI"
    # label="Matchup"
    matchup is concat(away_team, ' @ ', home_team)
    #(doc) Regular season or Playoffs
    # label="Phase"
    phase is pick 'Regular season' when game_type = 'REG' else 'Playoffs'
    #(doc) Home win, Away win or Tie
    # label="Outcome"
    outcome is
      pick 'Home win' when result > 0
      pick 'Away win' when result < 0
      else 'Tie'
    #(doc) Final margin regardless of who won
    # label="Margin"
    margin is abs(result)
    #(doc) Indoor for a dome or a closed retractable roof, Outdoor otherwise
    # label="Venue"
    venue is pick 'Indoor' when roof = 'dome' or roof = 'closed' else 'Outdoor'

  measure:
    #(doc) Games played
    # label="Games"
    game_count is count()
    #(doc) Average combined points per game
    # number="0.0"
    # label="Points / game"
    avg_total_points is total.avg()
    #(doc) Share of games the home team won
    # percent
    # label="Home win rate"
    home_win_rate is count() { where: result > 0 } / nullif(game_count, 0)
    #(doc) Share of games that went to overtime
    # percent
    # label="Overtime rate"
    overtime_rate is count() { where: is_overtime } / nullif(game_count, 0)
    #(doc) Share of games decided by 8 points or fewer, one score
    # percent
    # label="One-score games"
    one_score_rate is count() { where: abs(result) <= 8 } / nullif(game_count, 0)

  #(doc) Scoring environment by season: points per game, home edge, close games and overtime
  view: by_season is {
    group_by:
      # number=id
      # label="Season"
      season
    aggregate: game_count, avg_total_points, home_win_rate, one_score_rate, overtime_rate
    order_by: season
  }

  #(doc) Average combined points per game by regular-season week, one line per season
  # line_chart
  view: scoring_by_week is {
    group_by:
      # label="Week"
      game_week
    group_by:
      # number=id
      # label="Season"
      season
    aggregate: avg_total_points
    where: game_type = 'REG'
    order_by: game_week
  }

  #(doc) Points per game indoors and outdoors
  # bar_chart
  view: by_venue is {
    group_by: venue
    aggregate: avg_total_points
    order_by: avg_total_points desc
  }
}

// The union is SQL because a game is one row with two teams on it, and asking
// about a team means reading whichever side it was on. Two half-queries make
// that one row per side, so a team's record is a plain group_by.
#(doc) One row per team per game, 2023-2025: the team, its opponent, home or away, points for and against, and the result from that team's side
source: team_games is duckdb.sql("""
  SELECT game_id || ':' || home_team AS team_game_id, game_id, season, game_week, game_type, game_date, home_team AS team, away_team AS opponent, true AS is_home,
         home_score AS points_for, away_score AS points_against, is_overtime, roof
  FROM 'data/games.parquet'
  UNION ALL
  SELECT game_id || ':' || away_team, game_id, season, game_week, game_type, game_date, away_team, home_team, false,
         away_score, home_score, is_overtime, roof
  FROM 'data/games.parquet'
""") extend {
  primary_key: team_game_id
  join_one: teams with team
  join_one: opponent_team is teams on opponent = opponent_team.team

  dimension:
    #(doc) Points for minus points against
    # label="Margin"
    margin is points_for - points_against
    #(doc) W, L or T from this team's side
    # label="Result"
    result is
      pick 'W' when points_for > points_against
      pick 'L' when points_for < points_against
      else 'T'
    #(doc) "vs DAL" at home, "@ DAL" away
    # label="Opponent"
    matchup is pick concat('vs ', opponent) when is_home else concat('@ ', opponent)
    #(doc) Regular season or Playoffs
    # label="Phase"
    phase is pick 'Regular season' when game_type = 'REG' else 'Playoffs'

  measure:
    #(doc) Games played
    # label="Games"
    game_count is count()
    #(doc) Wins
    # label="W"
    wins is count() { where: points_for > points_against }
    #(doc) Losses
    # label="L"
    losses is count() { where: points_for < points_against }
    #(doc) Share of games won, ties counted as half
    # percent
    # label="Win %"
    win_rate is (wins + count() { where: points_for = points_against } * 0.5) / nullif(game_count, 0)
    #(doc) Average points scored per game
    # number="0.0"
    # label="Points for / game"
    points_for_per_game is points_for.avg()
    #(doc) Average points allowed per game
    # number="0.0"
    # label="Points against / game"
    points_against_per_game is points_against.avg()
    #(doc) Total points scored minus allowed
    # label="Point differential"
    point_differential is points_for.sum() - points_against.sum()

  #(doc) Each team's regular-season record and scoring by season, best record first
  view: standings is {
    group_by:
      # number=id
      # label="Season"
      season
      team
      teams.full_name
      teams.conference_division
    aggregate: wins, losses, win_rate, points_for_per_game, points_against_per_game, point_differential
    where: game_type = 'REG'
    order_by: win_rate desc, point_differential desc
  }
}

#(doc) Every snap 2023-2025, one row per play: down, distance, field position, offense and defense, play type, yards, the play description, and expected points before (ep) and added (epa). Penalties that wiped out a play are `no_play`
source: plays is duckdb.table('data/plays.parquet') extend {
  join_one: games with game_id
  join_one: offense_team is teams on offense = offense_team.team

  dimension:
    #(doc) A dropback (pass) or a designed run; null for kicks, kneels, spikes and penalties
    # label="Play"
    pass_or_run is
      pick 'Pass' when play_type = 'pass'
      pick 'Run' when play_type = 'run'
      else null
    #(doc) 1st, 2nd, 3rd or 4th down
    # label="Down"
    down_label is
      pick '1st' when down = 1
      pick '2nd' when down = 2
      pick '3rd' when down = 3
      pick '4th' when down = 4
      else null
    #(doc) Yards to a first down, bucketed: Short (1-3), Medium (4-6), Long (7-10), Very long (11+)
    # label="Distance"
    distance is
      pick 'Short (1-3)' when to_go <= 3
      pick 'Medium (4-6)' when to_go <= 6
      pick 'Long (7-10)' when to_go <= 10
      pick 'Very long (11+)' when to_go > 10
      else null
    #(doc) Field position from the offense's side: Red zone is inside the opponent's 20
    # label="Field zone"
    field_zone is
      pick 'Own territory' when yardline_100 > 50
      pick 'Midfield to 20' when yardline_100 > 20
      pick 'Red zone' when yardline_100 <= 20
      else null
    #(doc) Explosive play: a pass of 20+ yards or a run of 10+
    # label="Explosive"
    is_explosive is (play_type = 'pass' and yards_gained >= 20) or (play_type = 'run' and yards_gained >= 10)

  measure:
    #(doc) Snaps counted
    # label="Plays"
    play_count is count()
    #(doc) Passes and runs only: the plays EPA rates are computed over
    # label="Pass + run plays"
    scrimmage_plays is count() { where: play_type = 'pass' or play_type = 'run' }
    #(doc) Share of scrimmage plays that were passes
    # percent
    # label="Pass rate"
    pass_rate is count() { where: play_type = 'pass' } / nullif(scrimmage_plays, 0)
    #(doc) Expected points added per scrimmage play, the standard efficiency rate: positive means the offense moved the scoreboard expectation forward
    # number="0.000"
    # label="EPA / play"
    epa_per_play is epa.avg() { where: play_type = 'pass' or play_type = 'run' }
    #(doc) EPA per dropback
    # number="0.000"
    # label="EPA / pass"
    epa_per_pass is epa.avg() { where: play_type = 'pass' }
    #(doc) EPA per designed run
    # number="0.000"
    # label="EPA / run"
    epa_per_run is epa.avg() { where: play_type = 'run' }
    #(doc) Share of scrimmage plays with positive EPA
    # percent
    # label="Success rate"
    success_rate is count() { where: epa > 0 and (play_type = 'pass' or play_type = 'run') } / nullif(scrimmage_plays, 0)
    #(doc) Yards gained per scrimmage play
    # number="0.0"
    # label="Yards / play"
    yards_per_play is yards_gained.avg() { where: play_type = 'pass' or play_type = 'run' }
    #(doc) Share of scrimmage plays that were explosive (pass 20+, run 10+)
    # percent
    # label="Explosive rate"
    explosive_rate is count() { where: is_explosive } / nullif(scrimmage_plays, 0)

  #(doc) Offensive efficiency by team and season: pass rate, EPA per play, success and explosive rates. Regular season only
  view: offense_by_team is {
    group_by:
      # number=id
      # label="Season"
      season
      # label="Team"
      offense
      offense_team.full_name
    aggregate: scrimmage_plays, pass_rate, epa_per_play, epa_per_pass, epa_per_run, success_rate, explosive_rate
    where: games.game_type = 'REG' and offense is not null
    order_by: epa_per_play desc
  }

  #(doc) How offenses call plays by down: pass rate, success and EPA per play
  view: by_down is {
    group_by: down_label
    aggregate: scrimmage_plays, pass_rate, success_rate, epa_per_play
    where: down_label is not null
    order_by: down_label
  }

  #(doc) League pass rate and EPA by season
  # bar_chart
  view: pass_rate_by_season is {
    group_by:
      # number=id
      # label="Season"
      season
    aggregate: pass_rate
    order_by: season
  }

  #(doc) Passing against running: EPA per play by season, the efficiency gap that drives pass rates
  view: pass_vs_run is {
    group_by:
      # number=id
      # label="Season"
      season
    aggregate: epa_per_pass, epa_per_run, pass_rate, explosive_rate
    order_by: season
  }
}

#(doc) Team codes, for the Team filter control's option list
query: team_suggest is teams -> {
  group_by: team
  order_by: team
}
