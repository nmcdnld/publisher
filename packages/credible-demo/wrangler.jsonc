// The Credible Demo Worker: the analyst API under /api/analyst, and the built
// SPA from dist/ with an index.html fallback so client routes resolve on a
// hard refresh. Set secrets with `wrangler secret put OPENROUTER_API_KEY` and
// `wrangler secret put ANALYST_ADMIN_TOKEN`; without the key the analyst runs
// its scripted planner.
{
   "name": "credible-demo",
   "main": "./worker/index.ts",
   "compatibility_date": "2026-09-01",
   "compatibility_flags": ["nodejs_compat"],
   "assets": {
      "directory": "./dist",
      "binding": "ASSETS",
      "not_found_handling": "single-page-application",
      "run_worker_first": ["/api/analyst/*"]
   },
   "vars": {
      "PUBLISHER_URL": "http://localhost:4000"
   }
}
