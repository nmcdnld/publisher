{
   "name": "@malloy-publisher/credible-demo",
   "description": "The front door for Malloy Publisher: Discover, Feed, Library and Threads",
   "version": "0.0.1",
   "private": true,
   "type": "module",
   "scripts": {
      "dev": "bunx --bun vite",
      "build": "bunx tsc -b && bunx --bun vite build",
      "build:standalone": "bunx --bun vite build -c vite.standalone.config.ts",
      "preview": "bunx --bun vite preview",
      "typecheck": "bunx tsc -b",
      "format": "bunx prettier --write 'src/**/*.{ts,tsx}'",
      "deploy": "bun run build && bunx wrangler deploy"
   },
   "dependencies": {
      "@emotion/react": "^11.14.0",
      "@emotion/styled": "^11.14.0",
      "@malloy-publisher/app-manifest": "workspace:*",
      "@malloy-publisher/sdk": "workspace:*",
      "@mui/icons-material": "^7.0.2",
      "@mui/material": "^7.0.2",
      "@tanstack/ai": "0.63.0",
      "@tanstack/ai-mcp": "0.6.0",
      "@tanstack/ai-openrouter": "0.20.1",
      "@tanstack/charts": "^0.18.0",
      "@tanstack/react-query": "^5.59.16",
      "chart.js": "^4.5.1",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "d3-scale": "^4.0.2",
      "d3-shape": "^3.2.0",
      "lucide-react": "^0.468.0",
      "radix-ui": "^1.4.2",
      "react": "^19.1.0",
      "react-dom": "^19.1.0",
      "react-router-dom": "^7.6.2",
      "recharts": "3.8.0",
      "sonner": "^2.0.6",
      "tailwind-merge": "^3.3.1",
      "zod": "^4.6.5"
   },
   "devDependencies": {
      "@tailwindcss/vite": "^4.1.11",
      "@types/d3-scale": "^4.0.9",
      "@types/d3-shape": "^3.2.0",
      "@types/react": "^19.1.7",
      "@types/react-dom": "^19.1.6",
      "@vitejs/plugin-react": "^4.3.1",
      "tailwindcss": "^4.1.11",
      "tw-animate-css": "^1.3.5",
      "typescript": "^5.8.3",
      "vite": "^6.3.6"
   }
}
